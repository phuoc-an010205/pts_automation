{
  "name": "pts-automation",
  "version": "0.1.0",
  "private": true,
  "description": "LAN-based Photoshop job forwarding system",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace @pts/server",
    "dev:worker": "npm run dev --workspace @pts/worker",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
